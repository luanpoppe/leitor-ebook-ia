datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum BookFormat {
  EPUB @map("epub")
  PDF  @map("pdf")
  TXT  @map("txt")
  MD   @map("md")

  @@map("book_format")
}

enum BookStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")

  @@map("book_status")
}

model Book {
  id              String     @id @default(uuid(7)) @db.Uuid
  title           String
  author          String?
  format          BookFormat
  sizeBytes       Int        @map("size_bytes")
  hash            String     @unique @db.VarChar(64)
  storageKey      String     @map("storage_key")
  coverStorageKey String?    @map("cover_storage_key")
  status          BookStatus @default(PENDING)
  errorMessage    String?    @map("error_message")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapters Chapter[]
  readingProgress ReadingProgress?
  conversations Conversation[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "books_created_at_idx")
  @@map("books")
}

model Chapter {
  id       String @id @default(uuid(7)) @db.Uuid
  bookId   String @map("book_id") @db.Uuid
  position Int
  title    String? @db.VarChar(200)
  text     String

  book   Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chunks Chunk[]

  @@unique([bookId, position])
  @@map("chapters")
}

model Chunk {
  id        String                    @id @default(uuid(7)) @db.Uuid
  chapterId String                    @map("chapter_id") @db.Uuid
  position  Int
  text      String
  // NULL = trecho persistido ainda não vetorizado. A escrita de chunks é SQL puro
  // (pgvector via executeRaw), não migrar para o Prisma Client.
  embedding Unsupported("vector(1536)")?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, position])
  @@map("chunks")
}

model ReadingProgress {
  bookId          String   @id @map("book_id") @db.Uuid
  chapterPosition Int      @map("chapter_position")
  // Offset em caracteres dentro do capítulo. A coluna não se chama "offset"
  // porque OFFSET é palavra-chave da cláusula LIMIT/OFFSET em SQL bruto;
  // o campo do contrato da API continua `offset`.
  charOffset      Int      @map("char_offset")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reading_progress")
}

enum ChatRole {
  USER
  ASSISTANT

  @@map("chat_role")
}

model Conversation {
  id        String        @id @default(uuid(7)) @db.Uuid
  bookId    String        @map("book_id") @db.Uuid
  title     String?       @db.VarChar(120)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([bookId, updatedAt(sort: Desc)], map: "conversations_book_updated_idx")
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  citations      Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "chat_messages_conversation_created_idx")
  @@map("chat_messages")
}
