# Copie este arquivo para `.env` na raiz do repositório:
#   cp .env.example .env
#
# O arquivo `.env` NÃO é versionado (está no .gitignore).
# As portas abaixo são lidas pelo docker-compose.yml para mapear os serviços no host.

# --- Portas (host) ---
# Ao alterar qualquer *_PORT abaixo, atualize também as URLs de conexão mais abaixo
# (DATABASE_URL, REDIS_URL, MINIO_ENDPOINT) — o dotenv não interpola variáveis entre si.
POSTGRES_PORT=5436
REDIS_PORT=6380
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (credenciais usadas pelo docker-compose) ---
# Se mudar POSTGRES_USER ou POSTGRES_PASSWORD, reflita o mesmo par em DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leitor_ebook_ia

# --- URLs de conexão (backend / ferramentas locais) ---
# Portas e credenciais aqui devem bater com POSTGRES_* / REDIS_PORT / MINIO_API_PORT acima.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/leitor_ebook_ia
REDIS_URL=redis://localhost:6380

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ebooks

# --- IA (OpenRouter) ---
# Chave usada por @luanpoppe/ai para gerar os embeddings da ingestão.
# Sem ela a aplicação sobe e a extração funciona, mas a vetorização falha e o
# livro termina em `failed` com "Embeddings desativados: OPENROUTER_API_KEY não configurada.".
OPENROUTER_API_KEY=

# --- Frontend (Next) ---
# URL base da API consumida pelo frontend (prefixo NEXT_PUBLIC_ = vai para o bundle do browser).
NEXT_PUBLIC_API_URL=http://localhost:3026
